/-! ### Fast evaluation in compiled code

`slotVertices` is a `![…]` literal of rationals. In compiled code each
access walks the `Fin.cons` chain and re-normalizes the rational literal, and
the native certificate checkers access vertices tens of thousands of times
per row. The `@[csimp]` lemma below makes compiled code read a table of
rationals computed once at initialization instead. It is a proved equality,
so it changes speed only, not what is checked. (The table must hold data, not
functions: the compiler eta-expands function-valued definitions, so a table
of closures would still recompute on every access.) -/

/-- The coordinates of `slotVertices`, computed once. -/
def slotVerticesTable : Array (Array ℚ) :=
  Array.ofFn fun i : Fin 70 => Array.ofFn fun c : Fin 3 => slotVertices i c

def slotVerticesImpl (i : Fin 70) (c : Fin 3) : ℚ :=
  (slotVerticesTable[i.val]'(by simp [slotVerticesTable]))[c.val]'(by
    simp [slotVerticesTable])

@[csimp] theorem slotVertices_eq_impl : @slotVertices = @slotVerticesImpl := by
  funext i c
  simp [slotVerticesImpl, slotVerticesTable]

