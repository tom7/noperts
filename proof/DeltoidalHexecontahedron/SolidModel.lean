theorem seedVertices_xy_sq_le_one :
    ∀ t : Fin 14, (seedVertices t 0) ^ 2 + (seedVertices t 1) ^ 2 ≤ 1 := by
  decide +kernel

/-- The printed rational vertices agree with the tight rational rotations of
the seeds (`tightVertex`) to `4 · 10⁻¹⁶`. Kernel checked. -/
theorem slotVertices_tight_sq_close : ∀ i : Fin 70,
    (slotVertices i 0 - tightVertex seedVertices i 0) ^ 2 +
    (slotVertices i 1 - tightVertex seedVertices i 1) ^ 2 +
    (slotVertices i 2 - tightVertex seedVertices i 2) ^ 2 ≤ (4 / 10^16 : ℚ) ^ 2 := by
  decide +kernel

/-- Every rational vertex has norm in `[1/10, 1 - 10⁻¹²]`. -/
theorem slotVertices_sq_norm_bounds : ∀ i : Fin 70,
    (1 / 100 : ℚ) ≤ slotVertices i 0 ^ 2 + slotVertices i 1 ^ 2 + slotVertices i 2 ^ 2 ∧
      slotVertices i 0 ^ 2 + slotVertices i 1 ^ 2 + slotVertices i 2 ^ 2 ≤
        (1 - 1 / 10^12) ^ 2 := by
  decide +kernel

theorem orbits_check : icoOrbitsCheck 14 iOrbitCount vertexOrbitIndex vertexElementIndex
    orbitStabilizer orbitSlot orbitStab = true := by
  decide +kernel

/-- The deltoidal hexecontahedron's model for the certificate pipeline. -/
scoped instance icosahedralSolid : IcosahedralSolid where
  seedCount := 14
  seedCount_pos := by norm_num
  rationalVertices := slotVertices
  seedVertex := seedVertices
  seed_xy_sq_le_one := seedVertices_xy_sq_le_one
  tight_sq_close := slotVertices_tight_sq_close
  rationalVertex_sq_norm_bounds := slotVertices_sq_norm_bounds
  iOrbitCount := iOrbitCount
  iOrbitCount_pos := by decide
  vertexOrbitIndex := vertexOrbitIndex
  orbitStabilizer := orbitStabilizer
  vertexElementIndex := vertexElementIndex
  orbitSlot := orbitSlot
  orbitStab := orbitStab
  orbits_check := orbits_check

end DeltoidalHexecontahedron

