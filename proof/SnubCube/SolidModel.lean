module

public import Pipeline.OctaModel
public import SnubCube.ModelData
public import SnubCube.WedgeCoverData
public import Pipeline.OctaSolutionTree

@[expose] public section

/-!
# The snub cube as an octahedral solid model

The rational model (`ModelData`, generated by `search/sc/sc-model.cc`): the
O-orbit of one rational base point in the C4 rotation-major slot order (slot
`6 k + s` is `Rz(π/2)^k` times seed `s`). `octahedralSolid` (a scoped
instance) makes it an `OctahedralSolid`, hence a `SolidModel` for the
certificate pipeline; the facts it needs are checked by the kernel.
-/

namespace SnubCube

open Noperts Noperts.Pipeline
open scoped Matrix

theorem slots_check : octaSlotsCheck slotElemData = true := by decide +kernel

theorem rational_check : ∀ i : Fin (4 * 6),
    rationalVerticesData i =
      (octaMatrixQ ⟨slotElemData.getD i.val 0 % 24, Nat.mod_lt _ (by norm_num)⟩) *ᵥ base := by
  decide +kernel

theorem rationalVertices_sq_norm_bounds : ∀ i : Fin (4 * 6),
    (1 / 100 : ℚ) ≤ rationalVerticesData i 0 ^ 2 + rationalVerticesData i 1 ^ 2 +
        rationalVerticesData i 2 ^ 2 ∧
      rationalVerticesData i 0 ^ 2 + rationalVerticesData i 1 ^ 2 + rationalVerticesData i 2 ^ 2 ≤
        (1 - 1 / 10^12) ^ 2 := by
  decide +kernel

/-- The snub cube's model for the certificate pipeline. -/
scoped instance octahedralSolid : OctahedralSolid where
  base := base
  slotElem := slotElemData
  slots_check := slots_check
  rationalVertices := rationalVerticesData
  rational_check := rational_check
  rationalVertex_sq_norm_bounds := rationalVertices_sq_norm_bounds

/-- The code triangles that cover the view triangle (`WedgeCoverData`), for the
octahedral solution trees. A scoped instance, like `octahedralSolid`. -/
scoped instance codeTriangleCover : OctaCodeTriangleCover where
  codeTriangles := WedgeCover.codeTriangles
  baseTriangle := WedgeCover.baseTriangle
  coverTree := WedgeCover.coverTree
  baseTriangle_valid := WedgeCover.baseTriangle_valid
  octaViewTriangle_eq := by
    congr 1

end SnubCube

end
