theorem lexAny_tri1 {x : Fin 7 → ℝ³} (F : S0xFac 9 s0x_S29 x)
    (w1 : ℝ³) (hw1X : ⟪F.N 1, w1⟫ = 0) (hw1Y : ⟪F.N 2, w1⟫ = 0)
    (w3 : ℝ³) (hw3X : ⟪F.N 0, w3⟫ = 0) (hw3Y : ⟪F.N 6, w3⟫ = 0)
    (hA012 : 0 < ⟪F.N 0, w1⟫)
    (hA035 : ⟪F.N 3, w1⟫ < 0)
    (hA124 : 0 < ⟪F.N 4, w1⟫)
    (hA1456 : ⟪F.N 5, w1⟫ < 0)
    (hA234 : 0 < ⟪F.N 6, w1⟫)
    (hA346 : ⟪F.N 7, w1⟫ < 0)
    (hA356 : ⟪F.N 8, w1⟫ < 0)
    (hB234 : ⟪F.N 6, x 0 - x 1⟫ < 0)
    (hB346 : ⟪F.N 7, x 0 - x 1⟫ < 0)
    (hB356 : 0 < ⟪F.N 8, x 0 - x 1⟫)
    (hC015 : 0 < ⟪F.N 1, w3⟫)
