    (h3 : ⟪F.N 3, w⟫ = 0)
    (h4 : 0 < ⟪F.N 4, w⟫)
    (h5 : 0 < ⟪F.N 5, w⟫)
    (h6 : ⟪F.N 6, w⟫ < 0)
