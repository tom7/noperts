theorem c01_dep {x : Fin 7 → ℝ³} (F : S0xFac 9 s0x_S24 x) :
    ∀ s ∈ c01_D, ∃ mu : Fin 6 → ℝ, ∑ i, mu i = 0 ∧ ∑ i, mu i • x (c01_P i) = 0 ∧
      ∀ i, SignType.sign (mu i) = s i := by
  have hP : Function.Injective (fun i => x (c01_P i)) :=
