/-- Leaf 1: view `s05`, facings `DDDDUUUUU` (A..I, U up), cycle `1235`; 34 samples. -/
def h29s2_L1 : S0xSeg 7 9 4 where
  i := 0
  j := 5
  pat := ![false, false, false, false, true, true, true, true, true]
  c := ![1, 2, 3, 5]

theorem h29s2_L1_good : h29s2_L1.Good s0x_S29 := by decide

def H29SilE1 (T : Facets29 x) : Prop :=
  0 < T.f124.f (x 5) - T.f124.f (x 0) ∧
  0 < T.f234.f (x 5) - T.f234.f (x 0) ∧
  0 < T.f346.f (x 5) - T.f346.f (x 0) ∧
  RobUni (fun a : ZMod 4 => ⟪x (h29s2_L1.c a), x 5 - x 0⟫)

theorem h29s2_E1 (T : Facets29 x) (h : H29SilE1 T) : IsRupert (univ.image x) := by
  obtain ⟨l0, l1, l2, hU⟩ := h
  refine s0x_seg_rupert (s0x_fac29 T) T.inj h29s2_L1 h29s2_L1_good ⟨?_, hU⟩
