theorem lexAny_tri8 {x : Fin 7 → ℝ³} (F : S0xFac 9 s0x_S29 x)
    (w1 : ℝ³) (hw1X : ⟪F.N 2, w1⟫ = 0) (hw1Y : ⟪F.N 4, w1⟫ = 0)
    (w2 : ℝ³) (hw2X : ⟪F.N 0, w2⟫ = 0) (hw2Y : ⟪F.N 3, w2⟫ = 0)
    (hA012 : 0 < ⟪F.N 0, w1⟫)
    (hA015 : 0 < ⟪F.N 1, w1⟫)
