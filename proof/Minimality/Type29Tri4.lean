    · right; exact hz _ (by decide)
    · exact absurd rfl h1
    · right; exact hz _ (by decide)
    · left; decide
    · exact absurd rfl h2
    )
  have r1 := facet_pair F tri4_P mu hsum hdep 3 (i := 1) (j := 6) (by decide) (by decide) (by decide)
    (by
    intro l h1 h2
    fin_cases l
