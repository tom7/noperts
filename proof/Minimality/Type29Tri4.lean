    · left; show det3 (x 3 - x 1) (x 6 - x 1) (x 1 - x 1) = 0
      simp only [det3_expand, PiLp.sub_apply]; ring
    · right; exact hz _ (by decide)
    · left; show det3 (x 3 - x 1) (x 6 - x 1) (x 3 - x 1) = 0
