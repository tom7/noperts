    (by
    intro l h1 h2
    fin_cases l
    · exact absurd rfl h1
    · exact absurd rfl h2
    · right; exact hz _ (by decide)
    · left; decide
    · right; exact hz _ (by decide)
    · left; decide
    · left; decide
    )
  have r4 := (sign_rel_same (plane_rel0 (fun i => x (tri4_P i)) mu hsum hdep (x 3 - x 1) (x 6 - x 1) (x 1) (i := 0) (j := 5) (by decide)
    (by
    intro l h1 h2
