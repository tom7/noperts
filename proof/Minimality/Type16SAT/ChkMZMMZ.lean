/-- **Core MZMMZ gives Rupert**, from the unsatisfiability of its numbered clauses: in the shape of `Core16ZW`. -/
theorem rupert_of_core_dataMZMMZ (hU : CoreUnsat rowsMZMMZ) : Core16ZW (-1) 0 (-1) (-1) := by
  intro y F hC h1 h2 h3 h4 hA
  exact caseSKX_of_unsat chunksMZMMZ rowsMZMMZ unitsMZMMZ clauseMZMMZ hU allOKMZMMZ F hC
    (unitsMZMMZ_true F (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith) (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith)
      (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith) (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith)) (clauseMZMMZ_true F hA)

end Minimality.H16K.SAT
