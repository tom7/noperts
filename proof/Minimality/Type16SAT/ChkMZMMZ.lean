/-- The row check of core MZMMZ. -/
def allDMZMMZ (n : Nat) : Bool := rowSKX unitsMZMMZ clauseMZMMZ chunksMZMMZ n

/-- Chunk 0 of core MZMMZ: all rows pass. -/
theorem chkMZMMZ0 : (rowsMZMMZ0.all allDMZMMZ) = true := by decide +kernel

/-- Chunk 1 of core MZMMZ: all rows pass. -/
theorem chkMZMMZ1 : (rowsMZMMZ1.all allDMZMMZ) = true := by decide +kernel

