/-- The row check of core PZMMZ. -/
def allDPZMMZ (n : Nat) : Bool := rowSKX unitsPZMMZ clausePZMMZ chunksPZMMZ n

/-- Chunk 0 of core PZMMZ: all rows pass. -/
theorem chkPZMMZ0 : (rowsPZMMZ0.all allDPZMMZ) = true := by decide +kernel

/-- Chunk 1 of core PZMMZ: all rows pass. -/
theorem chkPZMMZ1 : (rowsPZMMZ1.all allDPZMMZ) = true := by decide +kernel

