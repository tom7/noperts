/-- **Core PZMMZ gives Rupert**, from the unsatisfiability of its numbered clauses: in the shape of `Core16ZW`. -/
theorem rupert_of_core_dataPZMMZ (hU : CoreUnsat rowsPZMMZ) : Core16ZW 1 0 (-1) (-1) := by
  intro y F hC h1 h2 h3 h4 hA
  exact caseSKX_of_unsat chunksPZMMZ rowsPZMMZ unitsPZMMZ clausePZMMZ hU allOKPZMMZ F hC
    (unitsPZMMZ_true F (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith) (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith)
      (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith) (by simp only [br16, SgnP] at h1 h2 h3 h4; norm_num at h1 h2 h3 h4; linarith)) (clausePZMMZ_true F hA)

