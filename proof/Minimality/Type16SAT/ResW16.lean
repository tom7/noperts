module

public import Minimality.Type16SAT.FinalW16X
public import Minimality.Type16SAT.SSplit

@[expose] public section

/-!
# Type 16: the wall residue `PL`, `r = 1`, `c = 0`

On the residue of the walls (`g = d = q = r = 1`, the edge `x 1 - x 6` orthogonal to `x 0 - x 3` and `x 0 - x 6`, and
`c = ⟪x 0 - x 3, x 6 - x 3⟫ = 0`) the frame `E₁, E₂, E₃` is orthogonal and the solid is a box corner.  A split leaf
(Theorem 8.10 rows, `Split.split_core`) at an explicit view `w = ±(l₀ E₁ + l₁ E₂ + l₂ E₃)` passes:

* `isRupert_res_split`: the coordinate form of `split_core` on the residue (every rim test is `det3c` of coordinates
  times `D = det3 E₁ E₂ E₃`, every depth is `Σ Δ_k l_k ⟪E_k, E_k⟫`); the combinatorial side conditions are `decide`.
* Five leaves, by the region (`e, h, L = ⟪E₁, E₁⟫, ⟪E₂, E₂⟫, ⟪E₃, E₃⟫`):
  - `F4` (`a > 1`): rim `3 6 1 4 2 0`, edge `61`, corner `2`, next to the edge view `d16`;
  - `F1` (`a < 1 < p`): rim `4 1 5 3 0`, edge `15`, corner `4`, next to the edge view `d15`;
  - `F3` (`a < 1`, `p < 1`): rim `0 3 5 1 4`, edge `35`, corner `0`, next to the edge view `d35`;
  - `A` (`a < 1`, `p = 1`, `L < h`) and `D` (`a < 1`, `p = 1`, `h ≤ L`): rim `0 2 5 1 6`, edge `16`, corner `0`,
    resp. edge `60`, corner `5`.
  Every rim test and split row is a polynomial in `a, b, p, e, h, L`, written as a manifestly positive form
  (generated by L16R/tools/genres.py, checked here by `positivity` and `ring`).
* `NF16.isRupert_PL_res`: a normal form on the residue with `a ≠ 1` is Rupert.
* `H16.SAT.isRupert_wallR_all`, `isRupert_wallX_all`: the walls of `FinalW16`, `FinalW16X` with no residue.
-/

set_option autoImplicit false
open scoped RealInnerProductSpace
open Finset

namespace Minimality.NF16

variable {x : Fin 7 → ℝ³}

/-- The coordinates of the residue normal form (`g = d = q = r = 1`). -/
def resY (a b p : ℝ) : Fin 7 → Fin 3 → ℝ :=
  ![![1, 0, 0], ![0, 1, 1], ![a, b, 0], ![0, 0, 0], ![p, 1, 1], ![0, 1, 0], ![0, 0, 1]]

/-- The coefficient determinant of three coordinate vectors. -/
def resDet (A B C : Fin 3 → ℝ) : ℝ :=
  det3c (A 0) (A 1) (A 2) (B 0) (B 1) (B 2) (C 0) (C 1) (C 2)

/-- The inner product of two coordinate vectors for the diagonal metric `diag (e, h, l)`. -/
def resIp (e h l : ℝ) (A C : Fin 3 → ℝ) : ℝ := A 0 * C 0 * e + A 1 * C 1 * h + A 2 * C 2 * l

theorem res_x (N : NF16 x) (hg : N.g = 1) (hd : N.d = 1) (hq : N.q = 1) (hr : N.r = 1) (i : Fin 7) :
    x i = nfP N.o N.E₁ N.E₂ N.E₃ (resY N.a N.b N.p i 0) (resY N.a N.b N.p i 1) (resY N.a N.b N.p i 2) := by
  fin_cases i <;> simp [resY, N.x0, N.x1, N.x2, N.x3, N.x4, N.x5, N.x6, hg, hd, hq, hr]

theorem res_sub (N : NF16 x) (hg : N.g = 1) (hd : N.d = 1) (hq : N.q = 1) (hr : N.r = 1) (i j : Fin 7) :
    x i - x j = nfV N.E₁ N.E₂ N.E₃ ((resY N.a N.b N.p i - resY N.a N.b N.p j) 0)
      ((resY N.a N.b N.p i - resY N.a N.b N.p j) 1) ((resY N.a N.b N.p i - resY N.a N.b N.p j) 2) := by
  rw [res_x N hg hd hq hr i, res_x N hg hd hq hr j, nfP_sub]; simp only [Pi.sub_apply]

theorem res_det (E₁ E₂ E₃ : ℝ³) (A B l : Fin 3 → ℝ) (ς : ℝ) :
    Minimality.Split.det3 (nfV E₁ E₂ E₃ (A 0) (A 1) (A 2)) (nfV E₁ E₂ E₃ (B 0) (B 1) (B 2))
      (ς • nfV E₁ E₂ E₃ (l 0) (l 1) (l 2)) = ς * (resDet A B l * det3 E₁ E₂ E₃) := by
  have hs : ∀ (a b c : ℝ³) (s : ℝ), det3 a b (s • c) = s * det3 a b c := fun a b c s => by
    simp only [det3, real_inner_smul_right]
  rw [H16T.SAT.split_det3, hs, det3_nfV]; rfl

theorem res_inner (E₁ E₂ E₃ : ℝ³) (e12 : ⟪E₁, E₂⟫ = 0) (e13 : ⟪E₁, E₃⟫ = 0) (e23 : ⟪E₂, E₃⟫ = 0)
    (A l : Fin 3 → ℝ) (ς : ℝ) :
    ⟪nfV E₁ E₂ E₃ (A 0) (A 1) (A 2), ς • nfV E₁ E₂ E₃ (l 0) (l 1) (l 2)⟫ =
      ς * resIp ⟪E₁, E₁⟫ ⟪E₂, E₂⟫ ⟪E₃, E₃⟫ A l := by
  have e21 : ⟪E₂, E₁⟫ = 0 := by rw [real_inner_comm]; exact e12
  have e31 : ⟪E₃, E₁⟫ = 0 := by rw [real_inner_comm]; exact e13
  have e32 : ⟪E₃, E₂⟫ = 0 := by rw [real_inner_comm]; exact e23
  rw [real_inner_smul_right, inner_nfV, inner_nfV_right, inner_nfV_right, inner_nfV_right]
  simp only [e12, e13, e23, e21, e31, e32, resIp]; ring

/-- The frame is orthogonal on the residue. -/
theorem res_orth (N : NF16 x) (hg : N.g = 1) (hd : N.d = 1)
    (h1 : ⟪x 0 - x 3, x 1 - x 6⟫ = 0) (h2 : ⟪x 0 - x 6, x 1 - x 6⟫ = 0) (hc : ⟪x 0 - x 3, x 6 - x 3⟫ = 0) :
    ⟪N.E₁, N.E₂⟫ = 0 ∧ ⟪N.E₁, N.E₃⟫ = 0 ∧ ⟪N.E₂, N.E₃⟫ = 0 := by
  have v03 : x 0 - x 3 = N.E₁ := by rw [N.x0, N.x3]; simp only [nfP]; module
  have v16 : x 1 - x 6 = N.E₂ := by rw [N.x1, N.x6, hg, hd]; simp only [nfP]; module
  have v06 : x 0 - x 6 = N.E₁ - N.E₃ := by rw [N.x0, N.x6]; simp only [nfP]; module
  have v63 : x 6 - x 3 = N.E₃ := by rw [N.x6, N.x3]; simp only [nfP]; module
  rw [v03, v16] at h1
  rw [v06, v16, inner_sub_left, h1, zero_sub, neg_eq_zero, real_inner_comm] at h2
  rw [v03, v63] at hc
  exact ⟨h1, hc, h2⟩

/-! ### The coordinate conditions -/

/-- Strict rim tests in coordinates for the rim edges `E` (the view `l`). -/
def RimOK (a b p : ℝ) (E : List (Fin 7 × Fin 7)) (l : Fin 3 → ℝ) : Prop :=
  ∀ A B m : Fin 7, (A, B) ∈ E → m ≠ A → m ≠ B →
    0 < resDet (resY a b p B - resY a b p A) (resY a b p m - resY a b p A) l

/-- Strict split rows in coordinates (rows `(A, B, J)`: rim edge `A B`, end `J`; corner `C`, split edge `A0 A1`). -/
def RowsOK (a b p e h L : ℝ) (RL : List (Fin 7 × Fin 7 × Fin 7)) (C A0 A1 : Fin 7) (σ : ℝ) (l : Fin 3 → ℝ) : Prop :=
  ∀ A B J : Fin 7, (A, B, J) ∈ RL →
    0 < σ * (resIp e h L (resY a b p J - resY a b p C) l *
      resDet (resY a b p B - resY a b p A) (resY a b p A1 - resY a b p A0) l)

/-- **The split leaf on the residue, in coordinates.**  A rim `lab` (cycle of `k` vertices), a certificate (edge `ai`,
corner `ci`, sign `σ`) and coordinates `l` of the view whose rim tests (`resDet`) and split rows (`resIp` depths times
`resDet` rises) are strict give `IsRupert`; the view is `ς • (l 0 • E₁ + l 1 • E₂ + l 2 • E₃)` with `ς D > 0`. -/
theorem isRupert_res_split (N : NF16 x) (F : H21.S0xFac 8 Minimality.V2.fIdx x)
    (hg : N.g = 1) (hd : N.d = 1) (hq : N.q = 1) (hr : N.r = 1)
    (h1 : ⟪x 0 - x 3, x 1 - x 6⟫ = 0) (h2 : ⟪x 0 - x 6, x 1 - x 6⟫ = 0) (hc : ⟪x 0 - x 3, x 6 - x 3⟫ = 0)
    {k : ℕ} [NeZero k] (hk : 3 ≤ k) (lab : ZMod k → Fin 7) (hinj : ∀ i j : ZMod k, lab i = lab j → i = j)
    (ai ci : ZMod k) (hca : ci ≠ ai) (hca1 : ci ≠ ai + 1) (σ : ℝ) (l : Fin 3 → ℝ)
    (E : List (Fin 7 × Fin 7)) (hE : ∀ i : ZMod k, (lab i, lab (i + 1)) ∈ E) (hrim : RimOK N.a N.b N.p E l)
    (C A0 A1 : Fin 7) (hC : lab ci = C) (hA0 : lab ai = A0) (hA1 : lab (ai + 1) = A1)
    (RL : List (Fin 7 × Fin 7 × Fin 7))
    (hRL : ∀ i j : ZMod k, i ≠ ai → (j = i ∨ j = i + 1) → j ≠ ci → (lab i, lab (i + 1), lab j) ∈ RL)
    (hrows : RowsOK N.a N.b N.p ⟪N.E₁, N.E₁⟫ ⟪N.E₂, N.E₂⟫ ⟪N.E₃, N.E₃⟫ RL C A0 A1 σ l) :
    IsRupert (univ.image x) := by
  obtain ⟨e12, e13, e23⟩ := res_orth N hg hd h1 h2 hc
  obtain ⟨ς, -, hςD⟩ := exists_sign N.hD
  set w : ℝ³ := ς • nfV N.E₁ N.E₂ N.E₃ (l 0) (l 1) (l 2) with hw
  have hS := res_sub N hg hd hq hr
  have hrimN : Minimality.Split.StrictRimN x w lab := by
    intro m i h0 h1'
    rw [hS, hS, hw, res_det]
    have := hrim _ _ m (hE i) h0 h1'
    nlinarith [mul_pos this hςD]
  have hrowsN : Minimality.Split.SplitRows (fun i => x (lab i)) w ai ci (σ * det3 N.E₁ N.E₂ N.E₃) := by
    intro i j hi hj hjc
    simp only
    rw [hS, hS, hS, hw, res_det, res_inner N.E₁ N.E₂ N.E₃ e12 e13 e23, hC, hA0, hA1]
    have := hrows _ _ _ (hRL i j hi hj hjc)
    have hsq : 0 < (ς * det3 N.E₁ N.E₂ N.E₃) ^ 2 := by positivity
    have e : σ * det3 N.E₁ N.E₂ N.E₃ *
        (ς * resIp ⟪N.E₁, N.E₁⟫ ⟪N.E₂, N.E₂⟫ ⟪N.E₃, N.E₃⟫
          (resY N.a N.b N.p (lab j) - resY N.a N.b N.p C) l *
        (ς * (resDet (resY N.a N.b N.p (lab (i + 1)) - resY N.a N.b N.p (lab i))
          (resY N.a N.b N.p A1 - resY N.a N.b N.p A0) l * det3 N.E₁ N.E₂ N.E₃))) =
        (σ * (resIp ⟪N.E₁, N.E₁⟫ ⟪N.E₂, N.E₂⟫ ⟪N.E₃, N.E₃⟫
          (resY N.a N.b N.p (lab j) - resY N.a N.b N.p C) l *
        resDet (resY N.a N.b N.p (lab (i + 1)) - resY N.a N.b N.p (lab i))
          (resY N.a N.b N.p A1 - resY N.a N.b N.p A0) l)) *
          (ς * det3 N.E₁ N.E₂ N.E₃) ^ 2 := by ring
    rw [e]; exact mul_pos this hsq
  obtain ⟨w', hw', hfree⟩ := Minimality.Split.split_core hk x N.inj (H16T.SAT.noBetween16 F) lab
    (fun i j h => hinj i j h) w hrimN
    ai ci _ hca hca1 hrowsN
  exact Minimality.Split.FreeAt.isRupert hw' hfree

/-- Positivity of the metric on the residue frame. -/
theorem res_metric_pos (N : NF16 x) : 0 < ⟪N.E₁, N.E₁⟫ ∧ 0 < ⟪N.E₂, N.E₂⟫ ∧ 0 < ⟪N.E₃, N.E₃⟫ := by
  have hne : ∀ i j : Fin 7, i ≠ j → x i ≠ x j := fun i j h e => h (N.inj e)
  have v1 : x 0 - x 3 = N.E₁ := by rw [N.x0, N.x3]; simp only [nfP]; module
  have v2 : x 5 - x 3 = N.E₂ := by rw [N.x5, N.x3]; simp only [nfP]; module
  have v3 : x 6 - x 3 = N.E₃ := by rw [N.x6, N.x3]; simp only [nfP]; module
  have n1 : N.E₁ ≠ 0 := by rw [← v1]; exact sub_ne_zero.2 (hne 0 3 (by decide))
  have n2 : N.E₂ ≠ 0 := by rw [← v2]; exact sub_ne_zero.2 (hne 5 3 (by decide))
  have n3 : N.E₃ ≠ 0 := by rw [← v3]; exact sub_ne_zero.2 (hne 6 3 (by decide))
  exact ⟨real_inner_self_pos.2 n1, real_inner_self_pos.2 n2, real_inner_self_pos.2 n3⟩

/-! ### The five leaves (generated forms) -/

/-- The view of the leaf F1 (coordinates in `E₁, E₂, E₃`):
edge `15`, corner `4`, rim `4 1 5 3 0`: the view next to the edge view `d15 = d36`. -/
def lF1 (p e h L : ℝ) : Fin 3 → ℝ :=
  ![-(p - 1) * L, -2 * L, e * p * (p - 1) + 2 * h + 2 * L]

/-- The rim tests of the leaf `F1`; they need only `a ≤ 1` (so also serve `a = 1`, `ResA16`). -/
theorem rimF1le (a b p e h L : ℝ) (ha : 0 < a) (hb : 0 < b) (hb1 : 0 < 1 - b) (he : 0 < e) (hh : 0 < h)
    (hL : 0 < L) (ha1 : 0 ≤ 1 - a) (hp : 0 < p) (hp1 : 0 < p - 1) :
    RimOK a b p [(4, 1), (1, 5), (5, 3), (3, 0), (0, 4)] (lF1 p e h L) := by
  have c410 : 0 < resDet (resY a b p 1 - resY a b p 4) (resY a b p 0 - resY a b p 4) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (p) * ((2 : ℝ) * h + (4 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c412 : 0 < resDet (resY a b p 1 - resY a b p 4) (resY a b p 2 - resY a b p 4) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (p) * ((2 : ℝ) * L + (2 : ℝ) * (1 - b) * h + (2 : ℝ) * (1 - b) * L +
        (1 - b) * p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c413 : 0 < resDet (resY a b p 1 - resY a b p 4) (resY a b p 3 - resY a b p 4) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (p) * ((2 : ℝ) * h + (4 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c415 : 0 < resDet (resY a b p 1 - resY a b p 4) (resY a b p 5 - resY a b p 4) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (2 : ℝ) * (L) * (p))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c416 : 0 < resDet (resY a b p 1 - resY a b p 4) (resY a b p 6 - resY a b p 4) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (p) * ((2 : ℝ) * h + (2 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c150 : 0 < resDet (resY a b p 5 - resY a b p 1) (resY a b p 0 - resY a b p 1) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (L) * (1 + p))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c152 : 0 < resDet (resY a b p 5 - resY a b p 1) (resY a b p 2 - resY a b p 1) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (L) * ((2 : ℝ) * a + (1 - b) * (p - 1)))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c153 : 0 < resDet (resY a b p 5 - resY a b p 1) (resY a b p 3 - resY a b p 1) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((p - 1)) * (L))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c154 : 0 < resDet (resY a b p 5 - resY a b p 1) (resY a b p 4 - resY a b p 1) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (2 : ℝ) * (L) * (p))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c156 : 0 < resDet (resY a b p 5 - resY a b p 1) (resY a b p 6 - resY a b p 1) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((p - 1)) * (L))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c530 : 0 < resDet (resY a b p 3 - resY a b p 5) (resY a b p 0 - resY a b p 5) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((2 : ℝ) * h + (2 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c531 : 0 < resDet (resY a b p 3 - resY a b p 5) (resY a b p 1 - resY a b p 5) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((p - 1)) * (L))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c532 : 0 < resDet (resY a b p 3 - resY a b p 5) (resY a b p 2 - resY a b p 5) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (a) * ((2 : ℝ) * h + (2 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c534 : 0 < resDet (resY a b p 3 - resY a b p 5) (resY a b p 4 - resY a b p 5) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((2 : ℝ) * p * h + (2 : ℝ) * p * L + (p - 1) * L + p ^ 2 * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c536 : 0 < resDet (resY a b p 3 - resY a b p 5) (resY a b p 6 - resY a b p 5) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((p - 1)) * (L))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c301 : 0 < resDet (resY a b p 0 - resY a b p 3) (resY a b p 1 - resY a b p 3) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((2 : ℝ) * h + (4 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c302 : 0 < resDet (resY a b p 0 - resY a b p 3) (resY a b p 2 - resY a b p 3) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (b) * ((2 : ℝ) * h + (2 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c304 : 0 < resDet (resY a b p 0 - resY a b p 3) (resY a b p 4 - resY a b p 3) (lF1 p e h L) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        ((2 : ℝ) * h + (4 : ℝ) * L + p * (p - 1) * e))
      (by simp only [lF1, resY, resDet, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have c305 : 0 < resDet (resY a b p 0 - resY a b p 3) (resY a b p 5 - resY a b p 3) (lF1 p e h L) :=
