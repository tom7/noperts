namespace Minimality.H16.SAT

open Minimality Minimality.H21 Minimality.H29.SAT Minimality.H16K.SAT

/-- **A wall `e1 0 e3 e4` (`e1 ≠ 0`) from its two case cores, the Slide Lemma and the residue leaves**: no residue
hypothesis. -/
theorem isRupert_wall0_all {e1 e3 e4 : ℝ} (hT : Core16TW e1 0 e3 e4) (hZ : Core16ZW e1 0 e3 e4) (he1 : e1 ≠ 0)
    {x : Fin 7 → ℝ³} (T : Type16 x) (h : Vec16 e1 0 e3 e4 x) : IsRupert (univ.image x) := by
  by_cases hc : ⟪x 0 - x 3, x 6 - x 3⟫ = 0
  swap
  · exact isRupert_wall0_of hT hZ T h hc
  have F := Minimality.H16A.h16g_fac T
  have hne : C16 x ≠ 0 := T.det_ne
  by_cases hA : CaseT16 x
  · exact rupert_of_core_bothTW hT F hne h hA
  by_cases hz : ZShape16 x F
  · have N := T.toNF
    obtain ⟨hg, hd, hq⟩ := N.zshape_nf F hz
    simp only [CaseT16, not_or, not_not] at hA
    have h2 : C16 x * br16 x 0 1 3 4 = 0 := by
      have := h.2.1
      simpa [SgnP] using this
    have hr := N.r_eq_one hg hd hq h2
    have h0 : C16 x * br16 x 0 1 2 6 ≠ 0 := by
      have := h.1
      simp only [SgnP, he1, ite_false] at this
      intro e
      rw [e, mul_zero] at this
      exact lt_irrefl _ this
    exact N.isRupert_PL_res F hg hd hq hA.1 hA.2 hr hc (N.a_ne_one hg hd h0)
  · exact rupert_of_core_bothZW hZ F hne h hz

/-- The `sigma16` image of `isRupert_wall0_all`: the wall `(-e1) e4 e3 0`. -/
theorem isRupert_wall0_sigma_all {e1 e3 e4 : ℝ} (hT : Core16TW e1 0 e3 e4) (hZ : Core16ZW e1 0 e3 e4) (he1 : e1 ≠ 0)
    {x : Fin 7 → ℝ³} (T : Type16 x) (h : Vec16 (-e1) e4 e3 0 x) : IsRupert (univ.image x) := by
  have := isRupert_wall0_all hT hZ he1 T.sigma (vec16_sigma h)
  rwa [Minimality.image_sigma16] at this

/-- **Type 16, the walls `+0-+`, `-0-+`, `-+-0`, `++-0`**, with their residue. -/
theorem isRupert_wallR_all {x : Fin 7 → ℝ³} (T : Type16 x) (h : Cls16WallR x) : IsRupert (univ.image x) := by
  rcases h with h | h | h | h
  · exact isRupert_wall0_all rupert_of_corePZMPU rupert_of_corePZMPZ one_ne_zero T h
  · exact isRupert_wall0_all rupert_of_coreMZMPU rupert_of_coreMZMPZ (by norm_num) T h
  · exact isRupert_wall0_sigma_all rupert_of_corePZMPU rupert_of_corePZMPZ one_ne_zero T h
  · exact isRupert_wall0_sigma_all rupert_of_coreMZMPU rupert_of_coreMZMPZ (by norm_num) T
      (by rw [neg_neg]; exact h)

/-- **Type 16, the eight vectors of `Cls16WallX`**, with the residue of `+0--`, `-0--` and their images. -/
theorem isRupert_wallX_all {x : Fin 7 → ℝ³} (T : Type16 x) (h : Cls16WallX x) : IsRupert (univ.image x) := by
  rcases h with h | h | h | h | h | h | h | h
  · exact (not_cls16Dead T (cls16Dead_of_vec h (by norm_num) (by norm_num))).elim
  · exact (not_cls16Dead T (cls16Dead_of_vec h (by norm_num) (by norm_num))).elim
  · exact (not_cls16Dead T (cls16Dead_of_vec h (by norm_num) (by norm_num))).elim
  · exact (not_cls16Dead T (cls16Dead_of_vec h (by norm_num) (by norm_num))).elim
  · exact isRupert_wall0_all rupert_of_corePZMMU rupert_of_corePZMMZ one_ne_zero T h
  · exact isRupert_wall0_sigma_all rupert_of_corePZMMU rupert_of_corePZMMZ one_ne_zero T h
  · exact isRupert_wall0_all rupert_of_coreMZMMU rupert_of_coreMZMMZ (by norm_num) T h
  · exact isRupert_wall0_sigma_all rupert_of_coreMZMMU rupert_of_coreMZMMZ (by norm_num) T
      (by rw [neg_neg]; exact h)

end Minimality.H16.SAT
