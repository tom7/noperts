theorem rowsD (a b e h L : ℝ) (ha : 0 < a) (hb : 0 < b) (hb1 : 0 < 1 - b) (he : 0 < e) (hh : 0 < h)
    (hL : 0 < L) (ha1 : 0 < 1 - a) (hLh : 0 ≤ L - h) :
    RowsOK a b 1 e h L
      [(0, 2, 0), (0, 2, 2), (2, 5, 2), (5, 1, 1), (1, 6, 1), (1, 6, 6)]
      5 6 0 1 (lD b e h) := by
  have r020 : 0 < 1 * (resIp e h L (resY a b 1 0 - resY a b 1 5) (lD b e h) *
      resDet (resY a b 1 2 - resY a b 1 0) (resY a b 1 0 - resY a b 1 6) (lD b e h)) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (2 : ℝ) * (1 + b) * (e) * (h) * ((4 : ℝ) * b * e + (4 : ℝ) * (1 - a) * e +
        (3 : ℝ) * b * (1 - b) * h))
      (by simp only [lD, resY, resDet, resIp, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have r022 : 0 < 1 * (resIp e h L (resY a b 1 2 - resY a b 1 5) (lD b e h) *
      resDet (resY a b 1 2 - resY a b 1 0) (resY a b 1 0 - resY a b 1 6) (lD b e h)) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
        (2 : ℝ) * ((1 - b)) * (e) * (h) * (1 + (1 - a)) * ((4 : ℝ) * b * e +
        (4 : ℝ) * (1 - a) * e + (3 : ℝ) * b * (1 - b) * h))
      (by simp only [lD, resY, resDet, resIp, det3c, Pi.sub_apply, Matrix.cons_val, Matrix.cons_val_zero,
        Matrix.cons_val_one]; ring)
  have r252 : 0 < 1 * (resIp e h L (resY a b 1 2 - resY a b 1 5) (lD b e h) *
      resDet (resY a b 1 5 - resY a b 1 2) (resY a b 1 0 - resY a b 1 6) (lD b e h)) :=
    lt_of_lt_of_eq (by positivity : (0 : ℝ) <
