/-! ### The residue -/

/-- The rims of the five leaves (cycles of vertex labels). -/
def labF1 : ZMod 5 → Fin 7 := ![4, 1, 5, 3, 0]
def labF3 : ZMod 5 → Fin 7 := ![0, 3, 5, 1, 4]
def labF4 : ZMod 6 → Fin 7 := ![3, 6, 1, 4, 2, 0]
def labAD : ZMod 5 → Fin 7 := ![0, 2, 5, 1, 6]

-- The split rows of each leaf (by `decide`).
set_option synthInstance.maxHeartbeats 2000000 in
set_option synthInstance.maxSize 4096 in
theorem rlF3 : ∀ i j : ZMod 5, i ≠ 1 → (j = i ∨ j = i + 1) → j ≠ 0 →
    (labF3 i, labF3 (i + 1), labF3 j) ∈
      ([(0, 3, 3), (5, 1, 5), (5, 1, 1), (1, 4, 1), (1, 4, 4), (4, 0, 4)]
        : List (Fin 7 × Fin 7 × Fin 7)) := by decide
set_option synthInstance.maxHeartbeats 2000000 in
set_option synthInstance.maxSize 4096 in
theorem rlA : ∀ i j : ZMod 5, i ≠ 3 → (j = i ∨ j = i + 1) → j ≠ 0 →
    (labAD i, labAD (i + 1), labAD j) ∈
      ([(0, 2, 2), (2, 5, 2), (2, 5, 5), (5, 1, 5), (5, 1, 1), (6, 0, 6)]
        : List (Fin 7 × Fin 7 × Fin 7)) := by decide
set_option synthInstance.maxHeartbeats 2000000 in
set_option synthInstance.maxSize 4096 in
theorem rlD : ∀ i j : ZMod 5, i ≠ 4 → (j = i ∨ j = i + 1) → j ≠ 2 →
    (labAD i, labAD (i + 1), labAD j) ∈
      ([(0, 2, 0), (0, 2, 2), (2, 5, 2), (5, 1, 1), (1, 6, 1), (1, 6, 6)]
        : List (Fin 7 × Fin 7 × Fin 7)) := by decide
set_option synthInstance.maxHeartbeats 2000000 in
set_option synthInstance.maxSize 4096 in
theorem rlF1 : ∀ i j : ZMod 5, i ≠ 1 → (j = i ∨ j = i + 1) → j ≠ 0 →
    (labF1 i, labF1 (i + 1), labF1 j) ∈
      ([(4, 1, 1), (5, 3, 5), (5, 3, 3), (3, 0, 3), (3, 0, 0), (0, 4, 0)]
        : List (Fin 7 × Fin 7 × Fin 7)) := by decide
set_option synthInstance.maxHeartbeats 2000000 in
set_option synthInstance.maxSize 4096 in
theorem rlF4 : ∀ i j : ZMod 6, i ≠ 1 → (j = i ∨ j = i + 1) → j ≠ 4 →
    (labF4 i, labF4 (i + 1), labF4 j) ∈
      ([(3, 6, 3), (3, 6, 6), (1, 4, 1), (1, 4, 4), (4, 2, 4), (2, 0, 0), (0, 3, 0), (0, 3, 3)]
        : List (Fin 7 × Fin 7 × Fin 7)) := by decide

/-- `a ≠ 1` from the sign of `C [0126]` (`= (1 - a) D²` on `g = d = 1`). -/
theorem a_ne_one (N : NF16 x) (hg : N.g = 1) (hd : N.d = 1)
    (h : H16.SAT.C16 x * H16.SAT.br16 x 0 1 2 6 ≠ 0) : N.a ≠ 1 := by
  have e : H16.SAT.C16 x * H16.SAT.br16 x 0 1 2 6 = (1 - N.a) * det3 N.E₁ N.E₂ N.E₃ ^ 2 := by
    simp only [H16.SAT.C16, H16.SAT.br16, N.x0, N.x1, N.x2, N.x3, N.x5, N.x6, nfP_sub, det3_nfV, det3c, hg, hd]
    ring
  intro ha; apply h; rw [e, ha]; ring

/-- **The residue of the walls is Rupert.**  A type 16 normal form on `Z` (`g = d = q = 1`) with `x 1 - x 6`
orthogonal to `x 0 - x 3` and `x 0 - x 6`, `r = 1`, `⟪x 0 - x 3, x 6 - x 3⟫ = 0` and `a ≠ 1` is Rupert: one of the
split leaves `F4` (`a > 1`), `F1` (`a < 1 < p`), `F3` (`a < 1`, `p < 1`), `A` / `D` (`a < 1`, `p = 1`, by
`⟪E₃, E₃⟫ < ⟪E₂, E₂⟫`). -/
theorem isRupert_PL_res (N : NF16 x) (F : H21.S0xFac 8 Minimality.V2.fIdx x)
    (hg : N.g = 1) (hd : N.d = 1) (hq : N.q = 1)
    (h1 : ⟪x 0 - x 3, x 1 - x 6⟫ = 0) (h2 : ⟪x 0 - x 6, x 1 - x 6⟫ = 0) (hr : N.r = 1)
    (hc : ⟪x 0 - x 3, x 6 - x 3⟫ = 0) (ha1 : N.a ≠ 1) : IsRupert (univ.image x) := by
  obtain ⟨he, hh, hL⟩ := res_metric_pos N
  have ha := N.ha
  have hb := N.hb
  have hab := N.hab
  have hp := N.hp
  have hb1 : 0 < 1 - N.b := by
    have t := N.tB125
    rw [hg, hd, hq] at t
    nlinarith
  rcases lt_or_gt_of_ne ha1 with ha1 | ha1
  · have ha1' : 0 < 1 - N.a := by linarith
    rcases lt_trichotomy N.p 1 with hp1 | hp1 | hp1
    · exact isRupert_res_split N F hg hd hq hr h1 h2 hc (k := 5) (by norm_num) labF3 (by decide) 1 0
        (by decide) (by decide) (-1) (lF3 N.a N.p ⟪N.E₁, N.E₁⟫ ⟪N.E₂, N.E₂⟫ ⟪N.E₃, N.E₃⟫)
        [(0, 3), (3, 5), (5, 1), (1, 4), (4, 0)] (by decide)
        (rimF3 _ _ _ _ _ _ ha hb hb1 he hh hL ha1' hp (by linarith)) 0 3 5 (by decide) (by decide) (by decide)
        [(0, 3, 3), (5, 1, 5), (5, 1, 1), (1, 4, 1), (1, 4, 4), (4, 0, 4)] rlF3
        (rowsF3 _ _ _ _ _ _ ha he hh hL ha1' hp (by linarith))
    · rcases lt_or_ge ⟪N.E₃, N.E₃⟫ ⟪N.E₂, N.E₂⟫ with hLh | hLh
      · exact isRupert_res_split N F hg hd hq hr h1 h2 hc (k := 5) (by norm_num) labAD (by decide) 3 0
          (by decide) (by decide) 1 (lA ⟪N.E₁, N.E₁⟫ ⟪N.E₂, N.E₂⟫)
          [(0, 2), (2, 5), (5, 1), (1, 6), (6, 0)] (by decide)
          (by rw [hp1]; exact rimA _ _ _ _ ha hb hb1 hab he hh ha1') 0 1 6 (by decide)
          (by decide) (by decide) [(0, 2, 2), (2, 5, 2), (2, 5, 5), (5, 1, 5), (5, 1, 1), (6, 0, 6)] rlA
          (by rw [hp1]; exact rowsA _ _ _ _ _ ha hb hab he hh hL ha1' (by linarith))
      · exact isRupert_res_split N F hg hd hq hr h1 h2 hc (k := 5) (by norm_num) labAD (by decide) 4 2
          (by decide) (by decide) 1 (lD N.b ⟪N.E₁, N.E₁⟫ ⟪N.E₂, N.E₂⟫)
          [(0, 2), (2, 5), (5, 1), (1, 6), (6, 0)] (by decide)
          (by rw [hp1]; exact rimD _ _ _ _ ha hb hb1 hab he hh ha1') 5 6 0 (by decide)
          (by decide) (by decide) [(0, 2, 0), (0, 2, 2), (2, 5, 2), (5, 1, 1), (1, 6, 1), (1, 6, 6)] rlD
          (by rw [hp1]; exact rowsD _ _ _ _ _ ha hb hb1 he hh hL ha1' (by linarith))
    · exact isRupert_res_split N F hg hd hq hr h1 h2 hc (k := 5) (by norm_num) labF1 (by decide) 1 0
        (by decide) (by decide) 1 (lF1 N.p ⟪N.E₁, N.E₁⟫ ⟪N.E₂, N.E₂⟫ ⟪N.E₃, N.E₃⟫)
