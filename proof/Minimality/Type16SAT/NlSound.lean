module

public import Minimality.Type16SAT.NlData

@[expose] public section

/-!
# L3, part 11: every route of the normal table is sound (generated by NlGen16.lean)
-/

set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000
open scoped RealInnerProductSpace
open Classical
open Minimality.H29.SAT

namespace Minimality.H16.SAT

/-- **Every route of the normal table gives the three valued sign of its determinant.** -/
theorem nlRoutes_sound {g : Geo} (hF : FacOK g) (hO : OriOK g) :
    ∀ k ∈ nlRoutes, Sg3 (rho g) (k.2.ent k.1) (det3 (g.N k.1.1) (g.N k.1.2.1) (g.N k.1.2.2)) := by
  unfold nlRoutes
  simp (config := {maxSteps := 100000000}) only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact nl_key1 hF hO _ _ _ 0 2 3 4 _ (by decide)  -- ROT1
  · exact nl_key0 hF hO _ _ _ 3 6 0 1 _ (by decide)  -- ROT0
  · exact nl_key2 hF hO _ _ _ 3 5 1 0 _ (by decide)  -- ROT2
  · exact nl_key0 hF hO _ _ _ 1 5 4 3 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 1 6 4 3 _ (by decide)  -- ROT0
  · exact nl_key1 hF hO _ _ _ 2 5 0 4 _ (by decide)  -- ROT1
  · exact nl_key1 hF hO _ _ _ 0 3 2 6 _ (by decide)  -- ROT1
  · exact nl_key0 hF hO _ _ _ 0 4 6 2 _ (by decide)  -- ROT0
  · exact nl_key2 hF hO _ _ _ 0 2 4 3 _ (by decide)  -- ROT2
  · exact nl_key2 hF hO _ _ _ 0 2 4 3 _ (by decide)  -- ROT2
  · exact nl_key0 hF hO _ _ _ 2 4 5 0 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 0 6 4 3 _ (by decide)  -- ROT0
  · exact nl_key2 hF hO _ _ _ 0 3 6 2 _ (by decide)  -- ROT2
  · exact nl_key2 hF hO _ _ _ 0 3 6 2 _ (by decide)  -- ROT2
  · exact nl_key1 hF hO _ _ _ 2 5 0 4 _ (by decide)  -- ROT1
  · exact nl_atom3 _ _ _  -- ATOM
  · exact nl_key0 hF hO _ _ _ 4 6 1 0 _ (by decide)  -- ROT0
  · exact nl_key1 hF hO _ _ _ 2 5 0 4 _ (by decide)  -- ROT1
  · exact nl_key0 hF hO _ _ _ 1 4 6 5 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 4 5 2 1 _ (by decide)  -- ROT0
  · exact nl_key1 hF hO _ _ _ 2 5 0 4 _ (by decide)  -- ROT1
  · exact nl_key1 hF hO _ _ _ 3 6 1 0 _ (by decide)  -- ROT1
  · exact nl_key0 hF hO _ _ _ 0 4 6 2 _ (by decide)  -- ROT0
  · exact nl_key1 hF hO _ _ _ 1 5 3 4 _ (by decide)  -- ROT1
  · exact nl_key1 hF hO _ _ _ 1 6 3 4 _ (by decide)  -- ROT1
  · exact nl_key0 hF hO _ _ _ 2 4 5 0 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 0 6 4 3 _ (by decide)  -- ROT0
  · exact nl_key1 hF hO _ _ _ 1 5 3 4 _ (by decide)  -- ROT1
  · exact nl_key1 hF hO _ _ _ 1 6 3 4 _ (by decide)  -- ROT1
  · exact nl_key2 hF hO _ _ _ 3 6 0 1 _ (by decide)  -- ROT2
  · exact nl_key1 hF hO _ _ _ 1 5 3 4 _ (by decide)  -- ROT1
  · exact nl_key0 hF hO _ _ _ 4 6 1 0 _ (by decide)  -- ROT0
  · exact nl_atom3 _ _ _  -- ATOM
  · exact nl_key0 hF hO _ _ _ 1 4 6 5 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 4 5 2 1 _ (by decide)  -- ROT0
  · exact nl_key2 hF hO _ _ _ 1 6 4 3 _ (by decide)  -- ROT2
  · exact nl_key0 hF hO _ _ _ 0 6 4 3 _ (by decide)  -- ROT0
  · exact nl_atom3 _ _ _  -- ATOM
  · exact nl_atom3 _ _ _  -- ATOM
  · exact nl_key1 hF hO _ _ _ 2 4 0 5 _ (by decide)  -- ROT1
  · exact nl_key2 hF hO _ _ _ 0 4 6 2 _ (by decide)  -- ROT2
  · exact nl_key0 hF hO _ _ _ 4 6 1 0 _ (by decide)  -- ROT0
  · exact nl_key1 hF hO _ _ _ 2 4 0 5 _ (by decide)  -- ROT1
  · exact nl_key0 hF hO _ _ _ 1 4 6 5 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 4 5 2 1 _ (by decide)  -- ROT0
  · exact nl_key1 hF hO _ _ _ 2 4 0 5 _ (by decide)  -- ROT1
  · exact nl_key2 hF hO _ _ _ 0 6 4 3 _ (by decide)  -- ROT2
  · exact nl_key0 hF hO _ _ _ 4 6 1 0 _ (by decide)  -- ROT0
  · exact nl_key2 hF hO _ _ _ 0 6 4 3 _ (by decide)  -- ROT2
  · exact nl_key0 hF hO _ _ _ 1 4 6 5 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 4 5 2 1 _ (by decide)  -- ROT0
  · exact nl_atom3 _ _ _  -- ATOM
  · exact nl_key0 hF hO _ _ _ 1 4 6 5 _ (by decide)  -- ROT0
  · exact nl_key0 hF hO _ _ _ 4 5 2 1 _ (by decide)  -- ROT0
  · exact nl_key2 hF hO _ _ _ 4 6 1 0 _ (by decide)  -- ROT2
  · exact nl_key1 hF hO _ _ _ 4 5 1 2 _ (by decide)  -- ROT1

end Minimality.H16.SAT
