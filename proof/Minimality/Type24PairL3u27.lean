theorem p_dep {x : Fin 7 → ℝ³} (F : S0xFac 9 s0x_S24 x) :
    ∀ s ∈ p_D, ∃ mu : Fin 7 → ℝ, ∑ i, mu i = 0 ∧ ∑ i, mu i • x (pP i) = 0 ∧
      ∀ i, SignType.sign (mu i) = s i := by
  have hP : Function.Injective (fun i => x (pP i)) := EdgeViewLink.inj_of_fac24 F
  intro s hs
  simp only [p_D, List.mem_cons, List.not_mem_nil, or_false] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact dep_of_chain F pP hP {0, 1, 2, 3, 5} (by decide) _ 0 (by decide) (by decide)
      [(6, 0, 1), (2, 1, 3), (3, 1, 2), (0, 3, 5)] (by decide)
  · exact dep_of_chain F pP hP {0, 1, 3, 4, 5} (by decide) _ 0 (by decide) (by decide)
      [(3, 1, 1), (6, 0, 4), (8, 0, 5), (2, 3, 4)] (by decide)
  · exact dep_of_chain F pP hP {0, 1, 2, 3, 6} (by decide) _ 0 (by decide) (by decide)
      [(5, 0, 3), (7, 0, 1), (0, 3, 6), (1, 2, 3)] (by decide)
  · exact dep_of_chain F pP hP {0, 1, 2, 4, 6} (by decide) _ 0 (by decide) (by decide)
      [(5, 0, 4), (0, 4, 6), (1, 2, 4), (4, 1, 2)] (by decide)
  · exact dep_of_chain F pP hP {0, 1, 3, 4, 6} (by decide) _ 0 (by decide) (by decide)
      [(8, 0, 1), (3, 1, 6), (4, 1, 3), (1, 3, 4)] (by decide)
  · exact dep_of_chain F pP hP {0, 2, 3, 4, 6} (by decide) _ 0 (by decide) (by decide)
      [(7, 0, 4), (8, 0, 2), (3, 2, 6), (4, 2, 3)] (by decide)
  · exact dep_of_chain F pP hP {0, 1, 2, 5, 6} (by decide) _ 0 (by decide) (by decide)
      [(5, 0, 5), (0, 5, 6), (1, 2, 5), (2, 1, 6)] (by decide)
  · exact dep_of_chain F pP hP {0, 2, 3, 5, 6} (by decide) _ 0 (by decide) (by decide)
      [(6, 0, 6), (7, 0, 5), (2, 3, 6), (3, 2, 6)] (by decide)

/-- **Pair closure at L3 and u27.** Facings `+0+0-----` at `w1` (facet 236 free) and
`++0-++-0+` at `w2` (facet 016 free), distinct vertex depths at both views: `LexAny`. -/
theorem lexAny_L3_u27 {x : Fin 7 → ℝ³} (F : S0xFac 9 s0x_S24 x) (w1 w2 : ℝ³)
    (a0 : 0 < ⟪F.N 0, w1⟫) (a1 : ⟪F.N 1, w1⟫ = 0) (a2 : 0 < ⟪F.N 2, w1⟫)
    (a3 : ⟪F.N 3, w1⟫ = 0) (a4 : ⟪F.N 4, w1⟫ < 0) (a5 : ⟪F.N 5, w1⟫ < 0)
    (a6 : ⟪F.N 6, w1⟫ < 0) (a8 : ⟪F.N 8, w1⟫ < 0)
    (b0 : 0 < ⟪F.N 0, w2⟫) (b2 : ⟪F.N 2, w2⟫ = 0) (b3 : ⟪F.N 3, w2⟫ < 0)
    (b4 : 0 < ⟪F.N 4, w2⟫) (b5 : 0 < ⟪F.N 5, w2⟫) (b6 : ⟪F.N 6, w2⟫ < 0)
    (b7 : ⟪F.N 7, w2⟫ = 0) (b8 : 0 < ⟪F.N 8, w2⟫)
    (hgen1 : ∀ i j : Fin 7, i ≠ j → ⟪x i, w1⟫ ≠ ⟪x j, w1⟫)
    (hgen2 : ∀ i j : Fin 7, i ≠ j → ⟪x i, w2⟫ ≠ ⟪x j, w2⟫) :
    Gen.LexAny F := by
  have hs1 : ∀ t : Fin 9, t ≠ 7 → SignType.sign ⟪F.N t, w1⟫ = pA_sw t := by
    intro t ht
    fin_cases t
    · exact sign_pos a0
    · exact sign_eq_zero_iff.mpr a1
    · exact sign_pos a2
    · exact sign_eq_zero_iff.mpr a3
    · exact sign_neg a4
    · exact sign_neg a5
    · exact sign_neg a6
    · exact absurd rfl ht
    · exact sign_neg a8
  have hs2 : ∀ t : Fin 9, t ≠ 1 → SignType.sign ⟪F.N t, w2⟫ = pB_sw t := by
    intro t ht
    fin_cases t
    · exact sign_pos b0
    · exact absurd rfl ht
    · exact sign_eq_zero_iff.mpr b2
    · exact sign_neg b3
    · exact sign_pos b4
    · exact sign_pos b5
    · exact sign_neg b6
    · exact sign_eq_zero_iff.mpr b7
    · exact sign_pos b8
  have hT1 : ∀ ρ ∈ pA_R, ∀ t, t ∈ ρ.U ∨ t ∈ ρ.Dn → t ≠ 7 := by decide
  have hT2 : ∀ ρ ∈ pB_R, ∀ t, t ∈ ρ.U ∨ t ∈ ρ.Dn → t ≠ 1 := by decide
  have hE1 : ∀ d ∈ pA_E, DecOK x pP w1 d := by
    intro d hd
    simp only [pA_E, List.mem_cons, List.not_mem_nil, or_false] at hd
    rcases hd with rfl | rfl
    · exact decOK_corner F pP pA_sw 1 ![0, 2, 6] ![5, 1, 0] (by decide) (by decide) (by decide)
        w1 (fun k => hs1 _ (by fin_cases k <;> decide))
    · exact decOK_corner F pP pA_sw 4 ![0, 3, 6] ![8, 4, 3] (by decide) (by decide) (by decide)
        w1 (fun k => hs1 _ (by fin_cases k <;> decide))
  have hE2 : ∀ d ∈ pB_E, DecOK x pP w2 d := by
    intro d hd
    simp only [pB_E, List.mem_cons, List.not_mem_nil, or_false] at hd
    rcases hd with rfl | rfl | rfl
    · exact decOK_tri F pP pB_sw 7 8 5 2 3 6 0 (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) w2 b7
        (hs2 8 (by decide)) (hs2 5 (by decide))
    · exact decOK_corner F pP pB_sw 4 ![0, 3, 6] ![8, 4, 3] (by decide) (by decide) (by decide)
        w2 (fun k => hs2 _ (by fin_cases k <;> decide))
    · exact decOK_corner F pP pB_sw 5 ![0, 2, 3] ![6, 3, 2] (by decide) (by decide) (by decide)
        w2 (fun k => hs2 _ (by fin_cases k <;> decide))
  exact pair_closure F pP w1 w2 pA_sw pB_sw pA_R pB_R
    (fun ρ hρ t ht => hs1 t (hT1 ρ hρ t ht)) (fun ρ hρ t ht => hs2 t (hT2 ρ hρ t ht))
    (hR_two F pA_sw pA_R 1 3 0 3 1 (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide))
    (hR_two F pB_sw pB_R 2 7 2 3 0 (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide))
    [] [] (by simp) (by simp) p_D (p_dep F) pA_E pB_E hE1 hE2 hgen1 hgen2 pB_bad
    p_check1 p_check2

