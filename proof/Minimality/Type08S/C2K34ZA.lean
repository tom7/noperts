module

public import Minimality.Type08S.C2K33ZA
public import Minimality.Type08S.C2K34LP
public import Minimality.Type08S.C2K34LQ

/-!
# K34 / Z: M stratum (N2 side), β6 = 1: the corners Lp = Lz = 0 and Lz = Lq = 0 (generated by tools/lexgen with
automatic LP side-fact certificates: `k32h_LpLz`, `k32h_LzLq`; specpos/LEXGEN). Left of the β6 = 1 ties: Lz = Lw = 0.
-/
@[expose] public section

set_option maxHeartbeats 1000000

set_option autoImplicit true
set_option relaxedAutoImplicit true
set_option linter.unusedVariables false

open scoped RealInnerProductSpace Topology
open Finset Filter

namespace Minimality
namespace Type08Sp
open C2

/-- What K34 leaves of the β6 = 1 ties: `Lz = Lw = 0` (`Lz = ⟪c'-c, u0⟫`, `Lw = ⟪a-c', u0⟫`). -/
def K34B4Rest (a a' b' c c' d : ℝ³) : Prop :=
  0 ≤ ⟪c' - a', b' - c⟫ ∧ ⟪c' - c, k28b4c_u0 a a' c c' d⟫ = 0 ∧ ⟪a - c', k28b4c_u0 a a' c c' d⟫ = 0

theorem k34_b4 {a a' b b' c c' d : ℝ³} {α1 β1 γ6 : ℝ}
    (hC : K6mCoords a a' b b' c c' d α1 β1 1 γ6) (hM : K6sM a a' b b' c c' d)
    (hrel : K16Rel a b c d α1 β1) (hα : 1 < α1) (hβ : 1 < β1) (hσ : β1 < 1 + γ6)
    (h : K33B4Rest a a' b b' c c' d) :
    HasLexCell (V8 a a' b b' c c' d) ∨ K34B4Rest a a' b' c c' d := by
  obtain ⟨hLp, ⟨hp, hz⟩ | ⟨hz, hq | hw⟩⟩ := h
  · exact Or.inl (k32h_LpLz hC hM hrel hα hβ hσ hp hz)
  · exact Or.inl (k32h_LzLq hC hM hrel hα hβ hσ hq hz)
  · exact Or.inr ⟨hLp, hz, hw⟩

/-- K33's boundary with the β6 = 1 corners Lp = Lz = 0 and Lz = Lq = 0 removed. -/
def K34mBoundary (a a' b b' c c' d : ℝ³) (α1 β1 β6 γ6 : ℝ) : Prop :=
  (1 < β1 ∧ β6 + γ6 = β1 ∧ ⟪a - c', a - d⟫ = 0 ∧ K33SigRest a a' b b' c c' d α1 β1 β6 γ6) ∨
    (1 < β1 ∧ β1 < β6 + γ6 ∧ 1 < α1 ∧ ((β6 = 1 ∧ K34B4Rest a a' b' c c' d) ∨ γ6 = 1))

def K34LeftMN2 {a a' b b' c c' d : ℝ³} (W : Norm08w a a' b b' c c' d) : Prop :=
  K6sMN2 a a' b b' c c' d ∧ ∃ α1 β1 β6 γ6 : ℝ, K6mCoords a a' b b' c c' d α1 β1 β6 γ6 ∧
    (RegN2 W.F → 1 < γ6) ∧
    (K34mBoundary a a' b b' c c' d α1 β1 β6 γ6 ∨
      (K6mH1Left a a' b b' c c' d α1 β1 β6 γ6 ∧ K17b2L2Left a a' b b' c c' d α1 β1 β6 γ6 ∧
        K33L2Corner a a' b b' c c' d α1 β1) ∨
      (K20mH5c a a' b b' c c' d α1 β1 β6 γ6 ∧ ⟪c' - a, b' - a⟫ ≤ 0))

theorem k34z_MN2 {a a' b b' c c' d : ℝ³} (W : Norm08w a a' b b' c c' d) (h : K33LeftMN2 W) :
    HasLexCell (V8 a a' b b' c c' d) ∨ K34LeftMN2 W := by
  obtain ⟨hs, α1, β1, β6, γ6, hC, hreg, h0 | hL | h5⟩ := h
  · rcases h0 with h0 | ⟨hβ1, hσ, hα1, ⟨hb, ht⟩ | hg⟩
    · exact Or.inr ⟨hs, α1, β1, β6, γ6, hC, hreg, Or.inl (Or.inl h0)⟩
    · have hrel : K16Rel a b c d α1 β1 := by
        obtain ⟨hdet, hc', hb', ha', hα1', -, -, -, hγ6', h3⟩ := hC
        exact k16_n2_rel W hs.1 hs.2.1 hs.2.2.1 hdet hc' ha' hα1' hβ1 hγ6' h3
      subst hb
      rcases k34_b4 hC hs.2.2 hrel hα1 hβ1 hσ ht with h1 | h1
      · exact Or.inl h1
      · exact Or.inr ⟨hs, α1, β1, 1, γ6, hC, hreg, Or.inl (Or.inr ⟨hβ1, hσ, hα1, Or.inl ⟨rfl, h1⟩⟩)⟩
    · exact Or.inr ⟨hs, α1, β1, β6, γ6, hC, hreg, Or.inl (Or.inr ⟨hβ1, hσ, hα1, Or.inr hg⟩)⟩
  · exact Or.inr ⟨hs, α1, β1, β6, γ6, hC, hreg, Or.inr (Or.inl hL)⟩
  · exact Or.inr ⟨hs, α1, β1, β6, γ6, hC, hreg, Or.inr (Or.inr h5)⟩

def K34Slice {a a' b b' c c' d : ℝ³} (W : Norm08w a a' b b' c c' d) : Prop :=
  K34LeftMN2 W ∨ K27LeftMKb W

theorem k34_slice_step {a a' b b' c c' d : ℝ³} (W : Norm08w a a' b b' c c' d)
    (hNR : ¬ IsRupert (V8 a a' b b' c c' d)) (h : K33Slice W) :
    HasLexCell (V8 a a' b b' c c' d) ∨ K34Slice W := by
  rcases h with h | h
  · rcases k34z_MN2 W h with h1 | h1
    · exact Or.inl h1
    · exact Or.inr (Or.inl h1)
  · exact Or.inr (Or.inr h)

def K34ResidP (a a' b b' c c' d : ℝ³) : Prop :=
  ∃ W : Norm08w a a' b b' c c' d, ResP W.F d ∧ K34Slice W

def K34ResidP6 (a a' b b' c c' d : ℝ³) : Prop :=
  K34ResidP a a' b b' c c' d ∨ K34ResidP b b' a a' c c' d ∨ K34ResidP a a' c c' b b' d ∨
  K34ResidP c c' a a' b b' d ∨ K34ResidP b b' c c' a a' d ∨ K34ResidP c c' b b' a a' d

/-- **`Resid08FinalK34`**: as K33 with the β6 = 1 corners Lp = Lz = 0 and Lz = Lq = 0 closed. -/
def Resid08FinalK34 (a a' b b' c c' d : ℝ³) : Prop :=
  (PlanarTwo a a' b b' c c' ∨ PlanarGen a a' b b' c c' d) ∧ K34ResidP6 a a' b b' c c' d ∧
    ¬ HasLexCell (V8 a a' b b' c c' d)

theorem k34_residP_step {p p' q q' r r' d : ℝ³}
    (hNR : ¬ IsRupert (V8 p p' q q' r r' d)) (h : K33ResidP p p' q q' r r' d) :
    HasLexCell (V8 p p' q q' r r' d) ∨ K34ResidP p p' q q' r r' d := by
  obtain ⟨W, hR, hs⟩ := h
  rcases k34_slice_step W hNR hs with h | h
  · exact Or.inl h
  · exact Or.inr ⟨W, hR, h⟩

theorem resid08FinalK33_imp_K34 {a a' b b' c c' d : ℝ³}
    (hNR : ¬ IsRupert (V8 a a' b b' c c' d)) (h : Resid08FinalK33 a a' b b' c c' d) :
    Resid08FinalK34 a a' b b' c c' d := by
  obtain ⟨hpl, h6, hno⟩ := h
  have e := type08_set_perm a a' b b' c c' d
  refine ⟨hpl, ?_, hno⟩
  rcases h6 with h | h | h | h | h | h
  · rcases k34_residP_step hNR h with h | h
    · exact (hno h).elim
    · exact Or.inl h
  · rcases k34_residP_step (fun hR => hNR (by rw [V8, ← e.2.1]; exact hR)) h with h | h
    · exact (hno (by rw [V8, ← e.2.1]; exact h)).elim
    · exact Or.inr (Or.inl h)
  · rcases k34_residP_step (fun hR => hNR (by rw [V8, ← e.2.2.1]; exact hR)) h with h | h
    · exact (hno (by rw [V8, ← e.2.2.1]; exact h)).elim
    · exact Or.inr (Or.inr (Or.inl h))
  · rcases k34_residP_step (fun hR => hNR (by rw [V8, ← e.2.2.2.1]; exact hR)) h with h | h
    · exact (hno (by rw [V8, ← e.2.2.2.1]; exact h)).elim
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · rcases k34_residP_step (fun hR => hNR (by rw [V8, ← e.2.2.2.2.1]; exact hR)) h with h | h
    · exact (hno (by rw [V8, ← e.2.2.2.2.1]; exact h)).elim
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))
  · rcases k34_residP_step (fun hR => hNR (by rw [V8, ← e.2.2.2.2.2]; exact hR)) h with h | h
    · exact (hno (by rw [V8, ← e.2.2.2.2.2]; exact h)).elim
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))

end Type08Sp
end Minimality
