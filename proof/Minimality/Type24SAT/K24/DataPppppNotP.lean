local notation:35 a:36 " AND " b:36 => V.gate true a true b
local notation:35 a:36 " ANDNOT " b:36 => V.gate true a false b
local notation:35 a:36 " NOTAND " b:36 => V.gate false a true b
local notation:35 a:36 " NOR " b:36 => V.gate false a false b
local notation:35 a:36 " WAND " b:36 => W.wgate true a true b
local notation:35 a:36 " WANDNOT " b:36 => W.wgate true a false b
local notation:35 a:36 " WNOTAND " b:36 => W.wgate false a true b
local notation:35 a:36 " WNOR " b:36 => W.wgate false a false b

