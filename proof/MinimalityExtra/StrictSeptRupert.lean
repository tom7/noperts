/-!
# `strict7_sept` is Rupert (explicit rational pose)

Proof of `MinimalityExtra.Strict7SeptIsRupert` (see `MinimalityExtra.lean`).  Generated by
`out/bottleneck/side5/gen_rupert.py`.  The pose is two rational rotations `SR1` (inner) and `SR2`
(outer), both exact rational rotation matrices from integer quaternions, an offset `SO`, and for
each inner vertex positive rational weights `SM j` over the seven outer projected vertices
(`Minimality.isRupert_of_pos_combinations`).  Everything is checked by `norm_num`.
-/

@[expose] public section

namespace MinimalityExtra
open Finset


/-- A pose given by index-wise positive weights is a Rupert passage. -/
theorem isRupert_of_index_posComb (X : Fin 7 → ℝ³) (hX : Function.Injective X)
    (hsol : (interior (convexHull ℝ ((Finset.univ.image X : Finset ℝ³) : Set ℝ³))).Nonempty)
    {R₁ R₂ : Matrix (Fin 3) (Fin 3) ℝ} (hR₁ : R₁ ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ) (hR₂ : R₂ ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ)
    (o : ℝ²) (m : Fin 7 → Fin 7 → ℝ) (hpos : ∀ j k, 0 < m j k) (hsum : ∀ j, ∑ k, m j k = 1)
    (heq : ∀ j, o + proj_xy (R₁.toEuclideanLin (X j)) = ∑ k, m j k • proj_xy (R₂.toEuclideanLin (X k))) :
    IsRupert (Finset.univ.image X) := by
  refine Minimality.isRupert_of_pos_combinations _ hsol hR₁ hR₂ o ?_
  intro v hv
  obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 hv
  have hinv : ∀ k, Function.invFun X (X k) = k := Function.leftInverse_invFun hX
  refine ⟨fun w => m j (Function.invFun X w), ?_, ?_, ?_⟩
  · intro w hw; exact hpos _ _
  · rw [Finset.sum_image (fun a _ b _ h => hX h)]
    simpa [hinv] using hsum j
  · rw [Finset.sum_image (fun a _ b _ h => hX h)]
    simpa [hinv] using heq j

