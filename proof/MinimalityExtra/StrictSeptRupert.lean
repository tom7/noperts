theorem sx_inj : Function.Injective SX := by
  intro a b h
  fin_cases a <;> fin_cases b <;> first | rfl | (exfalso; have h0 := congrArg (fun v : ℝ³ => v 0) h; norm_num [SX] at h0)

theorem sr_mem (R : Matrix (Fin 3) (Fin 3) ℝ) (h : R = SR1 ∨ R = SR2) : R ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ := by
  rw [Matrix.mem_specialOrthogonalGroup_iff, Matrix.mem_orthogonalGroup_iff]
  rcases h with rfl | rfl
  · constructor
    · ext i j; fin_cases i <;> fin_cases j <;> norm_num [SR1, Matrix.mul_apply, Fin.sum_univ_three, Matrix.star_eq_conjTranspose]
    · norm_num [SR1, Matrix.det_fin_three]
  · constructor
    · ext i j; fin_cases i <;> fin_cases j <;> norm_num [SR2, Matrix.mul_apply, Fin.sum_univ_three, Matrix.star_eq_conjTranspose]
    · norm_num [SR2, Matrix.det_fin_three]

theorem sx_hsol : (interior (convexHull ℝ ((Finset.univ.image SX : Finset ℝ³) : Set ℝ³))).Nonempty := by
  rw [← not_coplanar_iff_interior_convexHull_nonempty]
  refine Noperts.not_coplanar_of_det3_ne_zero (a := SX 0) (b := SX 1) (c := SX 2) (d := SX 3) ?_ ?_ ?_ ?_ ?_ <;>
    first | exact Finset.mem_image_of_mem _ (Finset.mem_univ _) | norm_num [Noperts.det3, Matrix.det_fin_three, SX]

set_option maxHeartbeats 4000000 in
theorem strict7SeptIsRupert : Strict7SeptIsRupert := by
  refine isRupert_of_index_posComb SX sx_inj sx_hsol (sr_mem SR1 (Or.inl rfl)) (sr_mem SR2 (Or.inr rfl)) SO SM ?_ ?_ ?_
  · intro j k; fin_cases j <;> fin_cases k <;> norm_num [SM]
  · intro j; fin_cases j <;> norm_num [SM, Fin.sum_univ_succ]
  · intro j; fin_cases j <;> (ext i; fin_cases i <;> norm_num [SM, SX, SR1, SR2, SO, proj_xy, Matrix.mulVec, dotProduct, Fin.sum_univ_succ, Fin.sum_univ_three])

#print axioms strict7SeptIsRupert

