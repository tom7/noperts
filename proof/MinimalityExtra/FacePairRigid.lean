module

public import Mathlib
public import MinimalityExtra

/-!
# Face-pair views of a type 24 polytope are all rigid

Proof of `MinimalityExtra.Type24FacePairViewsRigid` (see `MinimalityExtra.lean`).  Generated by a small
program from exact data (a rationalized shape scaled to integer coordinates).  The rigidity of a view is proved by a Farkas combination of the
corner rows: `corner_rows` turns a `TiltCert` at a silhouette corner into two strict linear
inequalities in `(ω, τ)` (the velocity must point strictly inside the corner's cone), and a
nonnegative combination of a few of them is identically zero (weights found by exact simplex,
closed here by `linarith`).
-/

@[expose] public section

set_option linter.unusedTactic false
set_option linter.unusedVariables false

local notation "ℝ³" => EuclideanSpace ℝ (Fin 3)
open scoped RealInnerProductSpace

namespace MinimalityExtra
open Finset

theorem det3_pluecker (m m' u u' w : ℝ³) :
    det3 m m' w * det3 u u' w = det3 m u w * det3 m' u' w - det3 m u' w * det3 m' u w := by
  simp only [det3]; ring

theorem det3_comb (a b v m w : ℝ³) :
    det3 a b w * det3 m v w = det3 (-b) v w * det3 m a w + det3 a v w * det3 m b w := by
  simp only [det3, PiLp.neg_apply]; ring

theorem det3_tri (a b c x m w : ℝ³) :
    det3 (c - b) (x - b) w * det3 m (a - x) w + det3 (a - c) (x - c) w * det3 m (b - x) w +
      det3 (b - a) (x - a) w * det3 m (c - x) w = 0 := by
  simp only [det3, PiLp.sub_apply]; ring

/-- Row positivity in the cone case. -/
theorem row_pos (m m' a b v w : ℝ³) (hmm : det3 m m' w ≠ 0)
    (hab : 0 < det3 a b w) (hav : 0 < det3 a v w) (hbv : 0 < det3 (-b) v w)
    (hma : 0 ≤ det3 m a w) (hmb : 0 ≤ det3 m b w) :
    0 < det3 m v w := by
  by_contra hneg
  rw [not_lt] at hneg
  have I := det3_comb a b v m w
  have h1 : det3 a b w * det3 m v w ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hab.le hneg
  have t1 : 0 ≤ det3 (-b) v w * det3 m a w := mul_nonneg hbv.le hma
  have t2 : 0 ≤ det3 a v w * det3 m b w := mul_nonneg hav.le hmb
  have e1 : det3 (-b) v w * det3 m a w = 0 := by linarith
  have e2 : det3 a v w * det3 m b w = 0 := by linarith
  have z1 : det3 m a w = 0 := by
    rcases mul_eq_zero.1 e1 with h | h
    · exact absurd h hbv.ne'
    · exact h
  have z2 : det3 m b w = 0 := by
    rcases mul_eq_zero.1 e2 with h | h
    · exact absurd h hav.ne'
    · exact h
  have P := det3_pluecker m m' a b w
  rw [z1, z2] at P
  have : det3 m m' w * det3 a b w = 0 := by rw [P]; ring
  rcases mul_eq_zero.1 this with h | h
  · exact hmm h
  · exact hab.ne' h

theorem corner_rows (V : Finset ℝ³) (w ω τ x p n : ℝ³)
    (h1 : ∀ y ∈ V, 0 ≤ det3 (n - x) (y - x) w) (h2 : ∀ y ∈ V, 0 ≤ det3 (x - p) (y - x) w)
    (hc : det3 (n - x) (x - p) w ≠ 0) (h : TiltCert V w ω τ x) :
    0 < det3 (n - x) (cross ω x + τ) w ∧ 0 < det3 (x - p) (cross ω x + τ) w := by
  have hc' : det3 (x - p) (n - x) w ≠ 0 := by
    intro h0; apply hc
    have : det3 (n - x) (x - p) w = - det3 (x - p) (n - x) w := by simp only [det3, PiLp.sub_apply]; ring
    rw [this, h0]; ring
  rcases h with ⟨y0, hy0, y1, hy1, hab, hv1, hv2⟩ | ⟨a, ha, b, hb, c, hc0, T, g1, g2, g3⟩
  · have e1 : det3 (-(y0 - x)) (cross ω x + τ) w = det3 (x - y0) (cross ω x + τ) w := by
      simp only [det3, PiLp.sub_apply, PiLp.neg_apply]; ring
    refine ⟨row_pos _ _ _ _ _ w hc hab hv1 (by rw [e1]; exact hv2) (h1 _ hy1) (h1 _ hy0),
      row_pos _ _ _ _ _ w hc' hab hv1 (by rw [e1]; exact hv2) (h2 _ hy1) (h2 _ hy0)⟩
  · exfalso
    have I1 := det3_tri a b c x (n - x) w
    have I2 := det3_tri a b c x (x - p) w
    have a1 := h1 a ha; have b1 := h1 b hb; have c1 := h1 c hc0
    have a2 := h2 a ha; have b2 := h2 b hb; have c2 := h2 c hc0
    have u1 : 0 < det3 (c - b) (x - b) w := g2
    have u2 : 0 < det3 (a - c) (x - c) w := g3
    have u3 : 0 < det3 (b - a) (x - a) w := g1
    have k1 : ∀ (m : ℝ³), 0 ≤ det3 m (a - x) w → 0 ≤ det3 m (b - x) w → 0 ≤ det3 m (c - x) w →
        det3 (c - b) (x - b) w * det3 m (a - x) w + det3 (a - c) (x - c) w * det3 m (b - x) w +
          det3 (b - a) (x - a) w * det3 m (c - x) w = 0 →
        det3 m (b - a) w = 0 ∧ det3 m (c - a) w = 0 := by
      intro m ma mb mc I
      have t1 := mul_nonneg u1.le ma
      have t2 := mul_nonneg u2.le mb
      have t3 := mul_nonneg u3.le mc
      have f1 : det3 (c - b) (x - b) w * det3 m (a - x) w = 0 := by linarith
      have f2 : det3 (a - c) (x - c) w * det3 m (b - x) w = 0 := by linarith
      have f3 : det3 (b - a) (x - a) w * det3 m (c - x) w = 0 := by linarith
      have z1 : det3 m (a - x) w = 0 := (mul_eq_zero.1 f1).resolve_left u1.ne'
      have z2 : det3 m (b - x) w = 0 := (mul_eq_zero.1 f2).resolve_left u2.ne'
      have z3 : det3 m (c - x) w = 0 := (mul_eq_zero.1 f3).resolve_left u3.ne'
      have lin : ∀ (p q : ℝ³), det3 m (p - q) w = det3 m (p - x) w - det3 m (q - x) w := by
        intro p q; simp only [det3, PiLp.sub_apply]; ring
      exact ⟨by rw [lin, z2, z1]; ring, by rw [lin, z3, z1]; ring⟩
    obtain ⟨p1, q1⟩ := k1 (n - x) (h1 a ha |> fun h => by simpa using h) (by simpa using b1) (by simpa using c1) I1
    obtain ⟨p2, q2⟩ := k1 (x - p) (by simpa using a2) (by simpa using b2) (by simpa using c2) I2
    have P := det3_pluecker (n - x) (x - p) (b - a) (c - a) w
    rw [p1, q1, p2, q2] at P
    have : det3 (n - x) (x - p) w * det3 (b - a) (c - a) w = 0 := by rw [P]; ring
    rcases mul_eq_zero.1 this with h | h
    · exact hc h
    · exact T.ne' h


