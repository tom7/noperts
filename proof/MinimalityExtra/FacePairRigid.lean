macro "rowtac" : tactic => `(tactic| (intro y hy; obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 hy; fin_cases i <;> first | (exfalso; revert hi; decide) | norm_num [det3, FX]))

theorem rigid_full_0_1_0 : cross (FN 0) (FN 1) ≠ 0 ∧ ¬ FreeAt (Finset.univ.image FX) (cross (FN 0) (FN 1)) := by
  have hw : cross (FN 0) (FN 1) = !₂[(37170352935661857426710 : ℝ), (-28306840995488688606831 : ℝ), (2430563942720534722725 : ℝ)] := by ext i; fin_cases i <;> norm_num [cross, FN]
  rw [hw]
  refine ⟨?_, ?_⟩
  · intro h0; have := congrArg (fun v : ℝ³ => v 0) h0; norm_num at this
  rintro ⟨ω, τ, h⟩
  obtain ⟨c1a, c1b⟩ := corner_rows _ _ ω τ (FX 1) (FX 2) (FX 6) (by rowtac) (by rowtac) (by norm_num [det3, FX]) (h _ (Finset.mem_image_of_mem _ (by decide)))
  obtain ⟨c2a, c2b⟩ := corner_rows _ _ ω τ (FX 2) (FX 5) (FX 1) (by rowtac) (by rowtac) (by norm_num [det3, FX]) (h _ (Finset.mem_image_of_mem _ (by decide)))
  obtain ⟨c5a, c5b⟩ := corner_rows _ _ ω τ (FX 5) (FX 3) (FX 2) (by rowtac) (by rowtac) (by norm_num [det3, FX]) (h _ (Finset.mem_image_of_mem _ (by decide)))
  obtain ⟨c6a, c6b⟩ := corner_rows _ _ ω τ (FX 6) (FX 1) (FX 4) (by rowtac) (by rowtac) (by norm_num [det3, FX]) (h _ (Finset.mem_image_of_mem _ (by decide)))
  norm_num [det3, cross, FX] at c1a c1b c2a c2b c5a c5b c6a c6b
  linarith

