module

@[expose] public section

/-!
# The snub dodecahedron's vertex slots as I-orbits (generated)

The snub dodecahedron's 60 vertices are one free orbit of the icosahedral
rotation group I: slot i is g_i · (slot 0), g_i = `vertexElementIndex[i]`,
and the base point's stabilizer is trivial. `vertexElementIndex` and its
inverse `elementVertexIndex` are generated by `scripts/snub-ico-group.py`
(the snub's per-solid section); the one-orbit tables below are derived from
them. The group itself is in `Pipeline.IcoGroupData`. See `Pipeline.IcoModel`
for the meaning of the tables.
-/

namespace SnubDodecahedron

/-- The number of I-orbits. -/
def iOrbitCount : Nat := 1

/-- The I-orbit of each vertex slot: all in orbit 0. -/
def vertexOrbitIndex : List Nat := List.replicate 60 0

/-- The base slot of each orbit. -/
def orbitBaseSlot : List Nat := [0]

/-- The stabilizer of each orbit's base point: trivial. -/
def orbitStabilizer : List (List Nat) := [[0]]

/-- slot i = icoEntry (vertexElement[i]) / 20 * slot 0. -/
def vertexElementIndex : List Nat := [0, 38, 9, 37, 3, 57, 29, 15, 11, 28, 44, 5, 1, 53, 16, 48, 6, 51, 31, 26, 18, 10, 49, 13, 4, 45, 33, 30, 14, 50, 42, 39, 35, 17, 27, 19, 12, 52, 23, 41, 32, 47, 56, 21, 54, 34, 40, 7, 20, 25, 36, 24, 43, 46, 59, 8, 58, 22, 55, 2]

/-- The inverse of `vertexElementIndex`. -/
def elementVertexIndex : List Nat := [0, 12, 59, 4, 24, 11, 16, 47, 55, 2, 21, 8, 36, 23, 28, 7, 14, 33, 20, 35, 48, 43, 57, 38, 51, 49, 19, 34, 9, 6, 27, 18, 40, 26, 45, 32, 50, 3, 1, 31, 46, 39, 30, 52, 10, 25, 53, 41, 15, 22, 29, 17, 37, 13, 44, 58, 42, 5, 56, 54]

/-- `orbitSlot[0][k]`: the slot j with vertexElement[j] = k. -/
def orbitSlot : List (List Nat) := [elementVertexIndex]

/-- `orbitStab[0][k]`: the identity. -/
def orbitStab : List (List Nat) := [List.replicate 60 0]

end SnubDodecahedron

end
